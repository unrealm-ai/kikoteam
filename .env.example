# Local Compose configuration. ./start.sh initializes .env once.
# Never commit .env; keep its secrets with your database backup.
# Hub and Engine tokens are generated separately in .kiko-local/runtime.env.
POSTGRES_DB=kikoteam
POSTGRES_USER=kiko
POSTGRES_PASSWORD=
# Generated once; never rotate automatically (also encrypts stored credentials).
KIKO_AUTH_SECRET=
KIKO_LOCAL_PORT=18080
KIKO_PUBLIC_ORIGIN=http://localhost:18080
# Configure SMTP and GitHub plugin OAuth in Settings > Platform Administration.
KIKO_TRUSTED_PROXY_CIDRS=
# Hosted deployments only. A platform administrator must separately enable provisioning.
KIKO_HOSTED_ASSISTANT_AVAILABLE=false

# Persistent asset root on this host. start.sh resolves ~ before mounting it.
KIKO_STORAGE_LOCAL_ROOT=~/.kiko/
# Any nonempty S3 field selects S3; incomplete config fails closed.
KIKO_STORAGE_S3_ENDPOINT=
KIKO_STORAGE_S3_BUCKET=
KIKO_STORAGE_S3_REGION=
KIKO_STORAGE_S3_PREFIX=
KIKO_STORAGE_S3_ACCESS_KEY_ID=
KIKO_STORAGE_S3_SECRET_ACCESS_KEY=
KIKO_STORAGE_S3_SESSION_TOKEN=
KIKO_STORAGE_S3_FORCE_PATH_STYLE=

# Optional administrator-approved private-network MCP CIDRs; never permits loopback/link-local.
KIKO_MCP_PRIVATE_CIDRS=
