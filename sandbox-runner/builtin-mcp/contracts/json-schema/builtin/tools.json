    {
      "name": "bash_write",
      "description": "Write UTF-8 text to a managed process or close ordinary stdin. Input receipts distinguish accepted, partial and indeterminate writes; never resend uncertain text automatically.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "process_id": {
            "$ref": "#/$defs/ProcessID"
          },
          "text": {
            "type": "string",
            "maxLength": 16384,
            "pattern": "^[^\\u0000]*$",
            "x-max-utf8-bytes": 16384
          },
          "close_stdin": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["process_id"],
        "examples": [
          {
            "process_id": "proc-00000000000000000000000001",
            "close_stdin": true
          },
          {
            "process_id": "proc-00000000000000000000000001",
            "text": "continue\n"
          }
        ],
        "description": "Write UTF-8 text to a managed process or close ordinary stdin. Input receipts distinguish accepted, partial and indeterminate writes; never resend uncertain text automatically.",
        "anyOf": [
          {
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": ["close_stdin"],
            "properties": {
              "close_stdin": {
                "const": true
              }
            }
          }
