{
  "tools": [
    {
      "name": "bash_list",
      "description": "List this Session's managed processes and retained exit records. Results contain metadata only; use bash_poll to retrieve output.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "$ref": "#/$defs/Cursor"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        },
        "examples": [
          {
            "limit": 50
          }
        ],
        "description": "List this Session's managed processes and retained exit records. Results contain metadata only; use bash_poll to retrieve output.",
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "Cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "outputSchema": {
        "anyOf": [
          {
            "$ref": "#/$defs/BashProcessPage"
          },
          {
            "$ref": "#/$defs/ToolFailure"
          }
        ],
        "examples": [
          {
            "error": {
              "code": "process_not_found",
              "message": "Process is unavailable"
            }
          },
          {
            "items": [],
            "next_cursor": null,
            "has_more": false
          }
        ],
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "BashProcessPage": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ProcessSummary"
                },
                "maxItems": 200
              },
              "next_cursor": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Cursor"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "has_more": {
                "type": "boolean"
              }
            },
            "required": ["items", "next_cursor", "has_more"],
            "additionalProperties": false
          },
          "Cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "ProcessID": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "ProcessState": {
            "type": "string",
            "enum": ["starting", "running", "terminating", "exited", "lost"]
          },
          "ProcessSummary": {
            "type": "object",
            "properties": {
              "process_id": {
                "$ref": "#/$defs/ProcessID"
              },
              "state": {
                "$ref": "#/$defs/ProcessState"
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "termination_signal": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TerminationSignal"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "deadline_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Null only when starting/lost and no confirmed spawn deadline is known."
              },
              "group_quiescent": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "started_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exited_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cwd": {
                "$ref": "#/$defs/WorkingDirectory"
              },
              "origin_turn_id": {
                "$ref": "#/$defs/TurnID"
              },
              "stop_reason": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/StopReason"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "process_id",
              "state",
              "exit_code",
              "termination_signal",
              "deadline_at",
              "group_quiescent",
              "created_at",
              "started_at",
              "exited_at",
              "cwd",
              "origin_turn_id",
              "stop_reason"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "enum": ["running", "terminating", "exited"]
                    }
                  },
                  "required": ["state"]
                },
                "then": {
                  "properties": {
                    "deadline_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          },
          "StopReason": {
            "type": "string",
            "enum": ["user_requested", "deadline_reached", "session_closed"]
          },
          "TerminationSignal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "ToolError": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          },
          "ToolFailure": {
            "type": "object",
            "properties": {
              "error": {
                "$ref": "#/$defs/ToolError"
              }
            },
            "required": ["error"],
            "additionalProperties": false
          },
          "TurnID": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "WorkingDirectory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/[^\\u0000]*$",
            "x-max-utf8-bytes": 4096
          }
        }
      }
    },
    {
      "name": "bash_poll",
      "description": "Read a managed process's current state and cursor-based output. Canceling this observation does not terminate the process or extend its runtime deadline.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "process_id": {
            "$ref": "#/$defs/ProcessID"
          },
          "cursor": {
            "$ref": "#/$defs/Cursor"
          },
          "yield_time_ms": {
            "$ref": "#/$defs/YieldTime",
            "default": 5000
          },
          "max_output_bytes": {
            "$ref": "#/$defs/OutputBudget",
            "default": 16384
          }
        },
        "required": ["process_id"],
        "examples": [
          {
            "process_id": "proc-00000000000000000000000001",
            "cursor": "opaque-position",
            "yield_time_ms": 5000
          }
        ],
        "description": "Read a managed process's current state and cursor-based output. Canceling this observation does not terminate the process or extend its runtime deadline.",
