    {
      "name": "bash_start",
      "description": "Start a managed Bash process and return its handle, state and initial output after a bounded yield. A running process is not a command failure; use bash_poll for later output.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "pattern": "^[^\\u0000]*[^\\u0000\\s][^\\u0000]*$",
            "x-max-utf8-bytes": 65536
          },
          "cwd": {
            "$ref": "#/$defs/WorkingDirectory",
            "default": "/workspace"
          },
          "tty": {
            "type": "boolean",
            "default": false
          },
          "stdin_open": {
            "type": "boolean",
            "description": "Defaults to true with tty=true, otherwise false. Explicit false with tty=true is invalid."
          },
          "yield_time_ms": {
            "$ref": "#/$defs/YieldTime",
            "default": 5000
          },
          "max_output_bytes": {
            "$ref": "#/$defs/OutputBudget",
            "default": 16384
          },
          "max_runtime_ms": {
            "$ref": "#/$defs/RuntimeBudget",
            "default": 600000,
            "description": "Also bounded by the trusted launch policy; poll/write do not extend it."
          }
        },
        "required": ["command"],
        "examples": [
          {
            "command": "cat",
            "tty": true
          },
          {
            "command": "printf ready",
            "yield_time_ms": 5000
          }
        ],
        "description": "Start a managed Bash process and return its handle, state and initial output after a bounded yield. A running process is not a command failure; use bash_poll for later output.",
        "allOf": [
          {
            "if": {
              "properties": {
                "tty": {
                  "const": true
                }
              },
              "required": ["tty"]
            },
            "then": {
              "properties": {
                "stdin_open": {
                  "const": true,
                  "default": true
                }
              }
            },
            "else": {
              "properties": {
                "stdin_open": {
                  "default": false
                }
              }
            }
          }
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "OutputBudget": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65536
          },
          "RuntimeBudget": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 86400000
          },
          "WorkingDirectory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/[^\\u0000]*$",
            "x-max-utf8-bytes": 4096
          },
          "YieldTime": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000
          }
        }
      },
      "outputSchema": {
        "anyOf": [
          {
            "$ref": "#/$defs/ProcessOutput"
          },
          {
            "$ref": "#/$defs/ProcessFailure"
          },
          {
            "$ref": "#/$defs/ToolFailure"
          }
        ],
        "examples": [
          {
            "error": {
              "code": "spawn_failed",
              "message": "Process could not be started"
            }
          },
          {
            "process_id": "proc-00000000000000000000000001",
            "state": "running",
            "exit_code": null,
            "termination_signal": null,
            "group_quiescent": false,
            "deadline_at": "2026-10-28T00:10:00Z",
            "chunks": [
              {
                "stream": "stdout",
                "text": "ready\n"
              }
            ],
            "next_cursor": "opaque-next",
            "first_available_cursor": "opaque-first",
            "has_more": false,
