{
  "name": "builtin-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "vendor/pi-tools/lib",
    "vendor/pi-tools/LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p vendor/pi-tools/tsconfig.json && tsc -p tsconfig.json && node scripts/resources.mjs",
    "typecheck": "node scripts/check-static.mjs --types-only",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test --test-timeout=60000 tests/*.test.mjs",
    "catalog": "npm run build && node dist/catalog.js",
    "lint": "eslint src tests scripts",
    "format:check": "prettier --check src tests scripts contracts *.json *.md",
    "fmt": "prettier --write src tests scripts contracts *.json *.md",
    "check:static": "node scripts/check-static.mjs",
    "check": "npm run check:static && npm run test:process",
    "test:process": "npm test && node --disable-warning=ExperimentalWarning --test --test-timeout=60000 tests/linux-process.mjs",
    "test:linux": "node scripts/require-linux.mjs && npm test && node --disable-warning=ExperimentalWarning --test --test-timeout=60000 tests/linux-process.mjs",
    "generate": "node scripts/management-schema.mjs",
    "check:generated": "node scripts/management-schema.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "image-size": "2.0.2",
    "node-pty": "1.1.0",
    "cross-spawn": "7.0.6",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@earendil-works/pi-tui": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "diff": "8.0.4",
    "typebox": "1.3.27",
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.19.19",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-agent-core": "1.5.2"
  }
}
